config_version=5

[application]

config/name="ekoi"
run/main_scene="uid://b0n3fufgbyjk2"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Globals="*res://globals/Globals.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="ekoi"

[file_customization]

folder_colors={
"res://assets/": "yellow",
"res://globals/": "red",
"res://math/": "teal",
"res://menus/": "blue",
"res://sim/": "green"
}

